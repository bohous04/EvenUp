auto-install-peers=true
strict-peer-dependencies=false
# Expo/React Native's Metro config does bare requires (e.g.
# `@react-native/js-polyfills`) that pnpm's isolated store hides, breaking
# `expo export`/EAS builds. Hoisted linking is the Expo-documented fix for pnpm
# monorepos; the pure-TS packages work unchanged under it.
node-linker=hoisted
